# Bisect worker. In Kubernetes it launches each test run as a sandboxed Job through kubectl,
# so the worker itself never executes repository code. With SANDBOX=docker it starts sandbox
# containers on the host daemon instead (local development).
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/cli/package.json apps/cli/
COPY apps/worker/package.json apps/worker/
COPY apps/mcp/package.json apps/mcp/
COPY packages/shared/package.json packages/shared/
COPY packages/analysis/package.json packages/analysis/
COPY packages/runner/package.json packages/runner/
RUN npm ci --no-audit --no-fund --omit=dev -w @causalci/worker -w @causalci/runner -w @causalci/analysis -w @causalci/shared

FROM bitnami/kubectl:1.31.4 AS kubectl
FROM docker:27.5-cli AS dockercli

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates tini && rm -rf /var/lib/apt/lists/*
COPY --from=kubectl /opt/bitnami/kubectl/bin/kubectl /usr/local/bin/kubectl
# Docker CLI only for docker-compose development (SANDBOX=docker); Kubernetes uses kubectl.
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /app
ENV NODE_ENV=production SANDBOX=kubernetes CACHE_DIR=/cache METRICS_PORT=9464
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
RUN mkdir -p /cache && chown node:node /cache
USER node
EXPOSE 9464
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node_modules/.bin/tsx", "apps/worker/src/index.ts"]
