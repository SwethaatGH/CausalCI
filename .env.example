# ── Backend (apps/api) ─────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./causalci.db
CORS_ORIGIN=http://localhost:5173

# Optional: raises GitHub API limit from 60 to 5,000 requests/hour. Never exposed to the browser.
GITHUB_TOKEN=

# ── Gemma 4 ────────────────────────────────────────────────────────
# Provider: "ollama" (default) or "gemini"
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# Gemini API (Gemma models), used when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# ── Limits ─────────────────────────────────────────────────────────
MAX_GRAPH_FILES=250
MAX_PARSE_FILES_PER_COMMIT=8
MAX_FILE_BYTES=300000
AI_TIMEOUT_MS=120000

# ── Sandboxed bisect jobs ──────────────────────────────────────────
# Jobs run other repositories' test suites. Off unless enabled; always off with PUBLIC_DEMO=true.
BISECT_JOBS_ENABLED=false
JOBS_TOKEN=
# Redis job queue (in-memory when unset). Workers: npm run worker
REDIS_URL=
# Run the worker inside the API process (needs Docker on this host)
INLINE_WORKER=false
# Docker runtime for sandboxes, e.g. runsc (gVisor)
SANDBOX_RUNTIME=

# ── Importing history ──────────────────────────────────────────────
# auto: local partial clone when git is available (no rate limit, nothing truncated); git; or api
IMPORT_MODE=auto
CACHE_DIR=./.causalci-cache
